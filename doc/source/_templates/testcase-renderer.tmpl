.. -*- mode: rst -*-

{% macro block(label, lang, code) %}
.. code-block:: {{ lang }}
   :caption: {{ label }}

   {% if lang == "yaml" %}
   {{ code | yaml_pretty | indent(width=3) }}
   {%- elif lang == "json" -%}
   {{ code | json_pretty | indent(width=3) }}
   {%- endif -%}
{% endmacro %}

{% macro events(before, after) %}
.. container:: side-by-side

   {{ block("Event before processing", "json", before) | indent(width=3) }}
   {{ block("Event after processing", "json", after) | indent(width=3) }}
{% endmacro %}

{% macro render_case(title, icon, rule, before, after, context, is_open) %}
.. dropdown:: {{ title }}
   :icon: {{ icon }}
{%- if is_open %}
   :open:
{% endif %}

   {{ block("Rule configuration", "yaml", rule) | indent(width=3) }}
   {% if context %}
      {% for path, spec in context.items() %}
         {% if spec is mapping and spec.body is defined %}
            {{- block("Content of ``" ~ path ~ "``", "yaml", spec.body) | indent(width=3) }}
         {% endif %}
      {% endfor %}
   {% endif %}
   {{ events(before, after) | indent(width=3) }}
{% endmacro %}

{#extra-safe-macro, doesn't crash on old tuple-based example_test_cases#}
{% macro case_from_item(item, is_open) %}
    {# Unwrap pytest.param if present, otherwise use the item directly #}
    {% set test_case = item.values[0] if item.values is defined and item.values else item %}
    {% set test_id = item.id if item.id is defined else test_case.id %}

    {# Safely extract context, falling back to None if undefined #}
    {% set context = test_case.context if test_case.context is defined else None %}

    {{- render_case("Example: " ~ test_id, "light-bulb", test_case.rule, test_case.event, test_case.expected, context, is_open) }}
{% endmacro %}

{#simpler macro for only new MockContext-based example_test_cases. Use this after converting all cases.
{% macro case_from_item(item, is_open) %}
    {% set test_case = item.values[0] if item.values is defined and item.values else item %}
    {% set test_id = item.id if item.id is defined else test_case.id %}

    {{- render_case("Example: " ~ test_id, "light-bulb", test_case.rule, test_case.event, test_case.expected, test_case.context | default(none), is_open) }}
{% endmacro %}
#}


{% set primary = data.example_test_cases if data.example_test_cases is defined else data.test_cases %}
{% set primary_ids = data.example_test_cases | map(attribute="id") | list %}
{% set extra = data.test_cases | rejectattr("id", "in", primary_ids) | list %}

{# --- actual template --- #}

{% for item in primary %}
   {{- case_from_item(item, false) }}
{% endfor %}

{% if extra %}
.. dropdown:: Additional examples
   :icon: list-unordered

   {% for item in extra %}
      {{- case_from_item(item, false) | indent(width=3) }}
   {% endfor %}
{% endif %}
